# Copy these variables into /root/haim-bot.env on the host. Never commit real credentials.
NODE_ENV=production
PORT=3010
BOT_MODE=shadow
DB_SCHEMA=haim_core_shadow
DATABASE_URL=
DB_POOL_MAX=12
LOG_LEVEL=info

AI_ENABLED=true
OPENAI_API_KEY=
# Model used for both repo prompts (write + phrase).
OPENAI_MODEL=gpt-6-luna
# Repo prompts (source of truth, sent as instructions every turn):
#   prompts/haim-write.he.md  — stage=write + tools + history
#   prompts/haim-phrase.he.md — stage=phrase + history + this_turn
# Legacy hosted IDs below are unused by the live agent path; kept for env parse / plan().
OPENAI_AGENT_PROMPT_ID=
OPENAI_AGENT_PROMPT_VERSION=
OPENAI_ACTION_PROMPT_ID=
OPENAI_ACTION_PROMPT_VERSION=
OPENAI_REPLY_PROMPT_ID=
OPENAI_REPLY_PROMPT_VERSION=
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_MS=45000
AGENT_MAX_TURNS=4
OPENAI_TRACING=false

WAHA_BASE_URL=http://127.0.0.1:3001
WAHA_SESSION=HAIM_YAHAD
WAHA_API_KEY=
WAHA_WEBHOOK_HMAC_KEY=
HAIM_ADMIN_TOKEN=
HAIM_ALLOW_SHORT_ADMIN_PIN=false
HAIM_ALLOW_ADMIN_CLEAR_ALL=false
ADMIN_PHONE=584152101
WAHA_TIMEOUT_MS=10000
WAHA_MEDIA_ORIGINS=

MEDIA_ROOT=/var/lib/haim-yahad-media
MEDIA_MAX_BYTES=26214400
MEDIA_TIMEOUT_MS=20000
MEDIA_VOLUME_CONFIRMED=false

IVRIT_API_TOKEN=
IVRIT_URL=https://misc-ten.vercel.app/transcribe_audio_assessors
IVRIT_TIMEOUT_MS=45000

TRANSPORT_CAPACITY=10
WORKER_CONCURRENCY=4
ENABLE_SIMULATE=true
INTEGRATION_DISPATCH=false
LIVE_ALLOWLIST=
LIVE_DEPENDENCIES_VERIFIED=false
MESSAGE_COALESCE_QUIET_MS=2800
MESSAGE_COALESCE_MAX_MS=30000
