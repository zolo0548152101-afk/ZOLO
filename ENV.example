# Copy these variables into EasyPanel Environment. Never commit real credentials.
NODE_ENV=production
PORT=3000
BOT_MODE=shadow
DB_SCHEMA=haim_core_shadow
DATABASE_URL=
DB_POOL_MAX=12
LOG_LEVEL=info

# Start with AI disabled for health/readiness/greeting checks.
# Enable with a real key for conversation simulation; this incurs API charges.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_PROMPT_ID=pmpt_6a9d0c66737881938a0f60f5df9088cb0806a26699929a86
OPENAI_PROMPT_VERSION=23
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_MS=45000
AGENT_MAX_TURNS=4
OPENAI_TRACING=false

WAHA_BASE_URL=http://whatsapp_waha:3000
WAHA_SESSION=HAIM_YAHAD
WAHA_API_KEY=
# Generate two DIFFERENT random secrets, each at least 32 characters.
WAHA_WEBHOOK_HMAC_KEY=
HAIM_ADMIN_TOKEN=
ADMIN_PHONE=584152101
WAHA_TIMEOUT_MS=10000
# Optional comma-separated EXACT origins for media only. No wildcards.
WAHA_MEDIA_ORIGINS=

MEDIA_ROOT=/data/haim-yahad-media
MEDIA_MAX_BYTES=26214400
MEDIA_TIMEOUT_MS=20000
MEDIA_VOLUME_CONFIRMED=false

IVRIT_API_TOKEN=
IVRIT_URL=https://misc-ten.vercel.app/transcribe_audio_assessors
IVRIT_TIMEOUT_MS=45000

# Capacity unit currently = one request/transport; owner must confirm actual capacity.
TRANSPORT_CAPACITY=10
WORKER_CONCURRENCY=4
ENABLE_SIMULATE=true
# Canonical comma-separated phones for a future restricted live pilot.
LIVE_ALLOWLIST=
LIVE_DEPENDENCIES_VERIFIED=false
