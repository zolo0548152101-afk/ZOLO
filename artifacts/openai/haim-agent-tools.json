[
  {
    "type": "function",
    "name": "donate",
    "description": "Open or update a donation / direct handoff request with items.",
    "strict": true,
    "parameters": {
      "type": "object",
      "properties": {
        "items": {
          "minItems": 1,
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "bed",
                  "sofa",
                  "wardrobe",
                  "fridge",
                  "oven",
                  "table_set",
                  "table",
                  "chairs",
                  "washing_machine",
                  "dryer",
                  "freezer",
                  "dishwasher",
                  "other",
                  "piano",
                  "house_move"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              }
            },
            "required": [
              "kind",
              "description",
              "quantity"
            ],
            "additionalProperties": false
          }
        },
        "counterparty_phone": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "counterparty_name": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                {
                  "type": "null"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "direct": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "free": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "working": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "items",
        "counterparty_phone",
        "counterparty_name",
        "direct",
        "free",
        "working"
      ],
      "additionalProperties": false
    }
  },
