{
  "name": "haim-yahad-bot-core",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/server.js",
    "migrate": "node dist/db/migrate-cli.js",
    "test": "tsc -p tsconfig.tests.json && node --test dist-tests/tests/unit.test.js",
    "test:integration": "tsc -p tsconfig.tests.json && node --test --test-concurrency=1 dist-tests/tests/integration.test.js",
    "test:ai": "node scripts/ai-eval.mjs",
    "check:spec": "node scripts/validate-spec.mjs",
    "check:probes": "node scripts/audit-offline-probes.mjs",
    "check:locations": "node scripts/location-stage.mjs tests/fixtures/beit-shean-streets-small.csv",
    "check:location-source": "node scripts/location-source-audit.mjs",
    "stage:official-streets": "node scripts/fetch-official-streets.mjs tests/fixtures/beit-shean-streets-official.csv",
    "activate:locations": "node scripts/activate-location-snapshot.mjs tests/fixtures/beit-shean-streets-official.csv",
    "check:sheets-schema": "node scripts/validate-sheets-schema.mjs tests/fixtures/sheets-v9-headers.csv",
    "check:sheets-reconcile": "node scripts/sheets-reconcile.mjs tests/fixtures/sheets-v9-small.csv",
    "check:legacy-mapping": "node scripts/validate-legacy-mapping.mjs \"C:/Users/זולו/Downloads/HAIM_YAHAD_AppsScript_V9-MATCHING.gs\"",
    "check:ai-eval": "node scripts/validate-ai-eval.mjs",
    "check:prompt-wiring": "node scripts/validate-prompt-wiring.mjs",
    "check": "npm run build && npm test",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@openai/agents": "0.17.2",
    "fastify": "5.12.3",
    "fastify-raw-body": "6.0.1",
    "node-pg-migrate": "9.0.0",
    "openai": "7.13.0",
    "pg": "8.23.0",
    "pg-boss": "12.30.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
